{
  // REQ-0352 §3-2 / REQ-0464 §2 — a type-check pass that covers `tests/`.
  //
  // `tsconfig.node.json` / `tsconfig.web.json` include only `src/`, so nothing
  // under `tests/` was ever type-checked and vitest strips types without
  // checking them.  That mattered first for the REQ-0352 undo gate (its
  // `satisfies Record<OptionalKey, …>` is a COMPILE-time assertion), and more
  // broadly it let test-only type drift accumulate silently — e.g. a
  // `generateAss` / `estimateOverlayHeightPx` signature change that vitest
  // could only catch at run time.
  //
  // REQ-0352 scoped `include` to a single gate file and DEFERRED widening it,
  // recording the ~19 pre-existing errors it would surface.  REQ-0464 §2 is
  // that deferred cleanup: those errors were fixed and `include` now covers the
  // whole suite, so `npm run typecheck` (which runs `tsc -p` on this config)
  // fails on any future test-side type break.
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  // `tests/**/*` is the suite; the ambient decls pull in the `window.electronAPI`
  // global augmentation (`env.d.ts`) so renderer service imports resolve.
  "include": [
    "tests/**/*",
    "src/renderer/env.d.ts",
    "src/**/*.d.ts"
  ]
}
